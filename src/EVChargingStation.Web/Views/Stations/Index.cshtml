@model List<ChargingStation>
@{
    ViewData["Title"] = "Charging Stations";
}

<div class="max-w-7xl mx-auto py-6 sm:px-6 lg:px-8">
    <!-- Header Section -->
    <div class="px-4 py-6 sm:px-0">
        <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between">
            <div>
                <h1 class="text-3xl font-bold text-gray-900">
                    <i class="fas fa-charging-station mr-3 text-primary-600"></i>
                    Charging Stations
                </h1>
                <p class="mt-2 text-sm text-gray-700">Manage and monitor all EV charging stations</p>
            </div>
            <div class="mt-4 sm:mt-0 sm:ml-4">
                <a asp-action="Create" class="btn-primary">
                    <i class="fas fa-plus mr-2"></i>
                    Add New Station
                </a>
            </div>
        </div>
    </div>

    <!-- Alerts -->
    @if (!string.IsNullOrEmpty(TempData["SuccessMessage"]?.ToString()))
    {
        <div class="mb-6 bg-success-50 border border-success-200 text-success-700 px-4 py-3 rounded-lg">
            <div class="flex items-center">
                <i class="fas fa-check-circle mr-2"></i>
                @TempData["SuccessMessage"]
            </div>
        </div>
    }

    @if (!string.IsNullOrEmpty(TempData["ErrorMessage"]?.ToString()))
    {
        <div class="mb-6 bg-danger-50 border border-danger-200 text-danger-700 px-4 py-3 rounded-lg">
            <div class="flex items-center">
                <i class="fas fa-exclamation-circle mr-2"></i>
                @TempData["ErrorMessage"]
            </div>
        </div>
    }

    <!-- Statistics Cards -->
    <div class="grid grid-cols-1 md:grid-cols-4 gap-4 mb-8">
        @{
            var totalStations = Model.Count;
            var activeStations = Model.Count(s => s.Status == StationStatus.Active);
            var inactiveStations = Model.Count(s => s.Status == StationStatus.Inactive);
            var maintenanceStations = Model.Count(s => s.Status == StationStatus.Maintenance);
        }
        
        <div class="bg-white rounded-lg shadow-md border border-gray-200 p-6">
            <div class="flex items-center">
                <div class="p-3 rounded-full bg-primary-100 text-primary-600">
                    <i class="fas fa-charging-station text-2xl"></i>
                </div>
                <div class="ml-4">
                    <p class="text-sm font-medium text-gray-500">Total Stations</p>
                    <p class="text-2xl font-bold text-gray-900">@totalStations</p>
                </div>
            </div>
        </div>

        <div class="bg-white rounded-lg shadow-md border border-gray-200 p-6">
            <div class="flex items-center">
                <div class="p-3 rounded-full bg-success-100 text-success-600">
                    <i class="fas fa-check-circle text-2xl"></i>
                </div>
                <div class="ml-4">
                    <p class="text-sm font-medium text-gray-500">Active</p>
                    <p class="text-2xl font-bold text-gray-900">@activeStations</p>
                </div>
            </div>
        </div>

        <div class="bg-white rounded-lg shadow-md border border-gray-200 p-6">
            <div class="flex items-center">
                <div class="p-3 rounded-full bg-gray-100 text-gray-600">
                    <i class="fas fa-pause-circle text-2xl"></i>
                </div>
                <div class="ml-4">
                    <p class="text-sm font-medium text-gray-500">Inactive</p>
                    <p class="text-2xl font-bold text-gray-900">@inactiveStations</p>
                </div>
            </div>
        </div>

        <div class="bg-white rounded-lg shadow-md border border-gray-200 p-6">
            <div class="flex items-center">
                <div class="p-3 rounded-full bg-warning-100 text-warning-600">
                    <i class="fas fa-wrench text-2xl"></i>
                </div>
                <div class="ml-4">
                    <p class="text-sm font-medium text-gray-500">Maintenance</p>
                    <p class="text-2xl font-bold text-gray-900">@maintenanceStations</p>
                </div>
            </div>
        </div>
    </div>

    <!-- Stations Table -->
    <div class="bg-white shadow-md rounded-lg border border-gray-200">
        <div class="px-6 py-4 border-b border-gray-200 bg-gray-50 rounded-t-lg">
            <h2 class="text-lg font-semibold text-gray-900">All Charging Stations</h2>
        </div>
        
        @if (Model.Any())
        {
            <div class="overflow-x-auto">
                <table class="min-w-full divide-y divide-gray-200">
                    <thead class="bg-gray-50">
                        <tr>
                            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Station</th>
                            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Location</th>
                            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Connectors</th>
                            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Status</th>
                            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Price/kWh</th>
                            <th class="px-6 py-3 text-right text-xs font-medium text-gray-500 uppercase tracking-wider">Actions</th>
                        </tr>
                    </thead>
                    <tbody class="bg-white divide-y divide-gray-200">
                        @foreach (var station in Model)
                        {
                            <tr class="hover:bg-gray-50 transition-colors">
                                <td class="px-6 py-4 whitespace-nowrap">
                                    <div class="flex items-center">
                                        <div class="flex-shrink-0 h-10 w-10">
                                            <div class="h-10 w-10 rounded-full bg-primary-100 flex items-center justify-center">
                                                <i class="fas fa-charging-station text-primary-600"></i>
                                            </div>
                                        </div>
                                        <div class="ml-4">
                                            <div class="text-sm font-medium text-gray-900">@station.Name</div>
                                            <div class="text-sm text-gray-500">@(station.Description.Length > 50 ? station.Description.Substring(0, 50) + "..." : station.Description)</div>
                                        </div>
                                    </div>
                                </td>
                                <td class="px-6 py-4 whitespace-nowrap">
                                    <div class="text-sm text-gray-900">@station.Address</div>
                                    <div class="text-sm text-gray-500">@station.Location.Latitude, @station.Location.Longitude</div>
                                </td>
                                <td class="px-6 py-4 whitespace-nowrap">
                                    <div class="flex flex-wrap gap-1">
                                        @foreach (var connector in station.Connectors.Take(3))
                                        {
                                            <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-blue-100 text-blue-800">
                                                @connector.Type (@connector.Power kW)
                                            </span>
                                        }
                                        @if (station.Connectors.Count > 3)
                                        {
                                            <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-gray-100 text-gray-800">
                                                +@(station.Connectors.Count - 3) more
                                            </span>
                                        }
                                    </div>
                                </td>
                                <td class="px-6 py-4 whitespace-nowrap">
                                    @switch (station.Status)
                                    {
                                        case StationStatus.Active:
                                            <span class="status-badge status-active">
                                                <i class="fas fa-check-circle mr-1"></i>Active
                                            </span>
                                            break;
                                        case StationStatus.Inactive:
                                            <span class="status-badge status-inactive">
                                                <i class="fas fa-pause-circle mr-1"></i>Inactive
                                            </span>
                                            break;
                                        case StationStatus.Maintenance:
                                            <span class="status-badge status-maintenance">
                                                <i class="fas fa-wrench mr-1"></i>Maintenance
                                            </span>
                                            break;
                                        case StationStatus.OutOfOrder:
                                            <span class="status-badge status-out-of-order">
                                                <i class="fas fa-times-circle mr-1"></i>Out of Order
                                            </span>
                                            break;
                                    }
                                </td>
                                <td class="px-6 py-4 whitespace-nowrap">
                                    <div class="text-sm font-medium text-gray-900">$@station.PricePerKWh.ToString("F2")</div>
                                </td>
                                <td class="px-6 py-4 whitespace-nowrap text-right text-sm font-medium">
                                    <div class="flex justify-end space-x-2">
                                        <a asp-action="Details" asp-route-id="@station.Id" 
                                           class="text-primary-600 hover:text-primary-900 transition-colors">
                                            <i class="fas fa-eye" title="View Details"></i>
                                        </a>
                                        <a asp-action="Edit" asp-route-id="@station.Id" 
                                           class="text-indigo-600 hover:text-indigo-900 transition-colors">
                                            <i class="fas fa-edit" title="Edit"></i>
                                        </a>
                                        
                                        <!-- Status Update Dropdown -->
                                        <div class="relative inline-block text-left">
                                            <button type="button" class="text-gray-600 hover:text-gray-900 transition-colors" 
                                                    onclick="toggleDropdown('status-@station.Id')">
                                                <i class="fas fa-cog" title="Change Status"></i>
                                            </button>
                                            <div id="status-@station.Id" class="origin-top-right absolute right-0 mt-2 w-48 rounded-md shadow-lg bg-white ring-1 ring-black ring-opacity-5 focus:outline-none hidden z-10">
                                                <div class="py-1">
                                                    @if (station.Status != StationStatus.Active)
                                                    {
                                                        <form asp-action="UpdateStatus" method="post" class="inline">
                                                            <input type="hidden" name="id" value="@station.Id" />
                                                            <input type="hidden" name="status" value="@((int)StationStatus.Active)" />
                                                            <button type="submit" class="block w-full text-left px-4 py-2 text-sm text-gray-700 hover:bg-gray-100">
                                                                <i class="fas fa-check-circle mr-2 text-success-600"></i>Set Active
                                                            </button>
                                                        </form>
                                                    }
                                                    @if (station.Status != StationStatus.Inactive)
                                                    {
                                                        <form asp-action="UpdateStatus" method="post" class="inline">
                                                            <input type="hidden" name="id" value="@station.Id" />
                                                            <input type="hidden" name="status" value="@((int)StationStatus.Inactive)" />
                                                            <button type="submit" class="block w-full text-left px-4 py-2 text-sm text-gray-700 hover:bg-gray-100">
                                                                <i class="fas fa-pause-circle mr-2 text-gray-600"></i>Set Inactive
                                                            </button>
                                                        </form>
                                                    }
                                                    @if (station.Status != StationStatus.Maintenance)
                                                    {
                                                        <form asp-action="UpdateStatus" method="post" class="inline">
                                                            <input type="hidden" name="id" value="@station.Id" />
                                                            <input type="hidden" name="status" value="@((int)StationStatus.Maintenance)" />
                                                            <button type="submit" class="block w-full text-left px-4 py-2 text-sm text-gray-700 hover:bg-gray-100">
                                                                <i class="fas fa-wrench mr-2 text-warning-600"></i>Set Maintenance
                                                            </button>
                                                        </form>
                                                    }
                                                    @if (station.Status != StationStatus.OutOfOrder)
                                                    {
                                                        <form asp-action="UpdateStatus" method="post" class="inline">
                                                            <input type="hidden" name="id" value="@station.Id" />
                                                            <input type="hidden" name="status" value="@((int)StationStatus.OutOfOrder)" />
                                                            <button type="submit" class="block w-full text-left px-4 py-2 text-sm text-gray-700 hover:bg-gray-100">
                                                                <i class="fas fa-times-circle mr-2 text-danger-600"></i>Set Out of Order
                                                            </button>
                                                        </form>
                                                    }
                                                </div>
                                            </div>
                                        </div>

                                        <button type="button" class="text-danger-600 hover:text-danger-900 transition-colors"
                                                onclick="confirmDelete('@station.Id', '@station.Name')">
                                            <i class="fas fa-trash" title="Delete"></i>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="px-6 py-12 text-center">
                <div class="mx-auto h-12 w-12 text-gray-400">
                    <i class="fas fa-charging-station text-4xl"></i>
                </div>
                <h3 class="mt-2 text-sm font-medium text-gray-900">No charging stations</h3>
                <p class="mt-1 text-sm text-gray-500">Get started by creating a new charging station.</p>
                <div class="mt-6">
                    <a asp-action="Create" class="btn-primary">
                        <i class="fas fa-plus mr-2"></i>
                        Add Station
                    </a>
                </div>
            </div>
        }
    </div>
</div>

<!-- Delete Confirmation Modal -->
<div id="deleteModal" class="fixed inset-0 bg-gray-600 bg-opacity-50 overflow-y-auto h-full w-full hidden z-50">
    <div class="relative top-20 mx-auto p-5 border w-96 shadow-lg rounded-md bg-white">
        <div class="mt-3 text-center">
            <div class="mx-auto flex items-center justify-center h-12 w-12 rounded-full bg-danger-100">
                <i class="fas fa-exclamation-triangle text-danger-600 text-xl"></i>
            </div>
            <h3 class="text-lg font-medium text-gray-900 mt-4">Delete Charging Station</h3>
            <div class="mt-2 px-7 py-3">
                <p class="text-sm text-gray-500">Are you sure you want to delete <strong id="stationName"></strong>? This action cannot be undone.</p>
            </div>
            <div class="items-center px-4 py-3">
                <form id="deleteForm" method="post" class="inline">
                    <button type="submit" class="btn-danger mr-2">Delete</button>
                </form>
                <button onclick="closeDeleteModal()" class="btn-secondary">Cancel</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function toggleDropdown(id) {
            const dropdown = document.getElementById(id);
            dropdown.classList.toggle('hidden');
            
            // Close other dropdowns
            document.querySelectorAll('[id^="status-"]').forEach(el => {
                if (el.id !== id) {
                    el.classList.add('hidden');
                }
            });
        }

        function confirmDelete(stationId, stationName) {
            document.getElementById('stationName').textContent = stationName;
            document.getElementById('deleteForm').action = '/Stations/Delete/' + stationId;
            document.getElementById('deleteModal').classList.remove('hidden');
        }

        function closeDeleteModal() {
            document.getElementById('deleteModal').classList.add('hidden');
        }

        // Close dropdowns when clicking outside
        document.addEventListener('click', function(event) {
            if (!event.target.matches('.fas.fa-cog') && !event.target.closest('[id^="status-"]')) {
                document.querySelectorAll('[id^="status-"]').forEach(el => {
                    el.classList.add('hidden');
                });
            }
        });
    </script>
}