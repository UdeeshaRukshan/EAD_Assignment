@model EditStationViewModel
@{
    ViewData["Title"] = "Edit Charging Station";
}

<div class="max-w-4xl mx-auto py-6 sm:px-6 lg:px-8">
    <!-- Header -->
    <div class="px-4 py-6 sm:px-0">
        <div class="flex items-center justify-between">
            <div>
                <h1 class="text-3xl font-bold text-gray-900">
                    <i class="fas fa-edit mr-3 text-primary-600"></i>
                    Edit Charging Station
                </h1>
                <p class="mt-2 text-sm text-gray-700">Update station details and configuration</p>
            </div>
            <div class="space-x-2">
                <a asp-action="Details" asp-route-id="@Model.Id" class="btn-secondary">
                    <i class="fas fa-eye mr-2"></i>
                    View Details
                </a>
                <a asp-action="Index" class="btn-secondary">
                    <i class="fas fa-arrow-left mr-2"></i>
                    Back to Stations
                </a>
            </div>
        </div>
    </div>

    <!-- Form -->
    <div class="bg-white shadow-md rounded-lg border border-gray-200">
        <form asp-action="Edit" method="post" class="space-y-6">
            <input asp-for="Id" type="hidden" />
            
            <div class="px-6 py-4 border-b border-gray-200 bg-gray-50 rounded-t-lg">
                <h2 class="text-lg font-semibold text-gray-900">Station Information</h2>
            </div>

            <div class="px-6 pb-6 space-y-6">
                <!-- Basic Information -->
                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                    <div>
                        <label asp-for="Name" class="block text-sm font-medium text-gray-700 mb-2">Station Name *</label>
                        <input asp-for="Name" type="text" 
                               class="form-input @(ViewData.ModelState["Name"]?.Errors.Count > 0 ? "border-red-500" : "")"
                               placeholder="Enter station name">
                        <span asp-validation-for="Name" class="text-red-500 text-sm"></span>
                    </div>

                    <div>
                        <label asp-for="Status" class="block text-sm font-medium text-gray-700 mb-2">Station Status *</label>
                        <select asp-for="Status" class="form-select @(ViewData.ModelState["Status"]?.Errors.Count > 0 ? "border-red-500" : "")">
                            <option value="0" class="text-success-600">Active</option>
                            <option value="1" class="text-gray-600">Inactive</option>
                            <option value="2" class="text-warning-600">Maintenance</option>
                            <option value="3" class="text-danger-600">Out of Order</option>
                        </select>
                        <span asp-validation-for="Status" class="text-red-500 text-sm"></span>
                    </div>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                    <div>
                        <label asp-for="PricePerKWh" class="block text-sm font-medium text-gray-700 mb-2">Price per kWh ($) *</label>
                        <input asp-for="PricePerKWh" type="number" step="0.01" min="0"
                               class="form-input @(ViewData.ModelState["PricePerKWh"]?.Errors.Count > 0 ? "border-red-500" : "")"
                               placeholder="0.00">
                        <span asp-validation-for="PricePerKWh" class="text-red-500 text-sm"></span>
                    </div>

                    <div>
                        <label asp-for="OpeningHours" class="block text-sm font-medium text-gray-700 mb-2">Operating Hours</label>
                        <input asp-for="OpeningHours" type="text"
                               class="form-input"
                               placeholder="e.g., 24/7 or 9:00 AM - 10:00 PM">
                    </div>
                </div>

                <div>
                    <label asp-for="Description" class="block text-sm font-medium text-gray-700 mb-2">Description</label>
                    <textarea asp-for="Description" rows="3"
                              class="form-input @(ViewData.ModelState["Description"]?.Errors.Count > 0 ? "border-red-500" : "")"
                              placeholder="Enter station description"></textarea>
                    <span asp-validation-for="Description" class="text-red-500 text-sm"></span>
                </div>

                <!-- Location Information -->
                <div class="border-t pt-6">
                    <h3 class="text-lg font-medium text-gray-900 mb-4">
                        <i class="fas fa-map-marker-alt mr-2 text-primary-600"></i>
                        Location Details
                    </h3>
                    
                    <div>
                        <label asp-for="Address" class="block text-sm font-medium text-gray-700 mb-2">Address *</label>
                        <input asp-for="Address" type="text"
                               class="form-input @(ViewData.ModelState["Address"]?.Errors.Count > 0 ? "border-red-500" : "")"
                               placeholder="Enter complete address">
                        <span asp-validation-for="Address" class="text-red-500 text-sm"></span>
                    </div>

                    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mt-4">
                        <div>
                            <label asp-for="Latitude" class="block text-sm font-medium text-gray-700 mb-2">Latitude *</label>
                            <input asp-for="Latitude" type="number" step="any"
                                   class="form-input @(ViewData.ModelState["Latitude"]?.Errors.Count > 0 ? "border-red-500" : "")"
                                   placeholder="e.g., 6.9271">
                            <span asp-validation-for="Latitude" class="text-red-500 text-sm"></span>
                        </div>

                        <div>
                            <label asp-for="Longitude" class="block text-sm font-medium text-gray-700 mb-2">Longitude *</label>
                            <input asp-for="Longitude" type="number" step="any"
                                   class="form-input @(ViewData.ModelState["Longitude"]?.Errors.Count > 0 ? "border-red-500" : "")"
                                   placeholder="e.g., 79.8612">
                            <span asp-validation-for="Longitude" class="text-red-500 text-sm"></span>
                        </div>
                    </div>
                </div>

                <!-- Connectors -->
                <div class="border-t pt-6">
                    <h3 class="text-lg font-medium text-gray-900 mb-4">
                        <i class="fas fa-plug mr-2 text-primary-600"></i>
                        Charging Connectors
                    </h3>
                    
                    <div id="connectorsContainer">
                        @for (int i = 0; i < Model.Connectors.Count; i++)
                        {
                            <div class="connector-item bg-gray-50 rounded-lg p-4 mb-4" data-index="@i">
                                <input type="hidden" asp-for="Connectors[i].Id" />
                                
                                <div class="flex justify-between items-start mb-4">
                                    <h4 class="text-md font-medium text-gray-900">
                                        <i class="fas fa-bolt mr-2 text-yellow-500"></i>
                                        Connector @(i + 1)
                                    </h4>
                                    <button type="button" onclick="removeConnector(@i)" 
                                            class="text-red-600 hover:text-red-800 transition-colors">
                                        <i class="fas fa-trash"></i>
                                    </button>
                                </div>
                                
                                <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                                    <div>
                                        <label class="block text-sm font-medium text-gray-700 mb-2">Connector Type *</label>
                                        <select asp-for="Connectors[i].Type" class="form-select" required>
                                            <option value="">Select Type</option>
                                            <option value="0">Type 1 (J1772)</option>
                                            <option value="1">Type 2 (Mennekes)</option>
                                            <option value="2">CHAdeMO</option>
                                            <option value="3">CCS (Combined Charging System)</option>
                                            <option value="4">Tesla Supercharger</option>
                                        </select>
                                    </div>
                                    
                                    <div>
                                        <label class="block text-sm font-medium text-gray-700 mb-2">Power (kW) *</label>
                                        <input asp-for="Connectors[i].Power" type="number" 
                                               class="form-input" min="1" max="350" step="0.1" required>
                                    </div>
                                    
                                    <div>
                                        <label class="block text-sm font-medium text-gray-700 mb-2">Status</label>
                                        <select asp-for="Connectors[i].Status" class="form-select">
                                            <option value="0">Available</option>
                                            <option value="1">Occupied</option>
                                            <option value="2">Reserved</option>
                                            <option value="3">Out of Order</option>
                                            <option value="4">Maintenance</option>
                                        </select>
                                    </div>
                                </div>
                                
                                <div class="mt-4 flex items-center">
                                    <input asp-for="Connectors[i].IsAvailable" type="checkbox" 
                                           class="h-4 w-4 text-primary-600 focus:ring-primary-500 border-gray-300 rounded">
                                    <label asp-for="Connectors[i].IsAvailable" class="ml-2 block text-sm text-gray-900">
                                        Connector is available for booking
                                    </label>
                                </div>
                            </div>
                        }
                    </div>
                    
                    <button type="button" onclick="addConnector()" class="mt-4 btn-secondary">
                        <i class="fas fa-plus mr-2"></i>
                        Add Connector
                    </button>
                </div>

                <!-- Amenities -->
                <div class="border-t pt-6">
                    <h3 class="text-lg font-medium text-gray-900 mb-4">
                        <i class="fas fa-concierge-bell mr-2 text-primary-600"></i>
                        Amenities
                    </h3>
                    
                    <div>
                        <label asp-for="Amenities" class="block text-sm font-medium text-gray-700 mb-2">Available Amenities</label>
                        <input asp-for="Amenities" type="text"
                               class="form-input"
                               placeholder="e.g., WiFi, Restroom, Coffee Shop (comma-separated)">
                        <p class="text-xs text-gray-500 mt-1">Separate multiple amenities with commas</p>
                    </div>
                </div>

                <!-- Form Actions -->
                <div class="border-t pt-6 flex justify-end space-x-4">
                    <a asp-action="Details" asp-route-id="@Model.Id" class="btn-secondary">
                        <i class="fas fa-times mr-2"></i>
                        Cancel
                    </a>
                    <button type="submit" class="btn-primary">
                        <i class="fas fa-save mr-2"></i>
                        Update Station
                    </button>
                </div>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        let connectorIndex = @Model.Connectors.Count;

        function addConnector() {
            const container = document.getElementById('connectorsContainer');
            const connectorHtml = `
                <div class="connector-item bg-gray-50 rounded-lg p-4 mb-4" data-index="${connectorIndex}">
                    <input type="hidden" name="Connectors[${connectorIndex}].Id" value="" />
                    
                    <div class="flex justify-between items-start mb-4">
                        <h4 class="text-md font-medium text-gray-900">
                            <i class="fas fa-bolt mr-2 text-yellow-500"></i>
                            Connector ${connectorIndex + 1}
                        </h4>
                        <button type="button" onclick="removeConnector(${connectorIndex})" 
                                class="text-red-600 hover:text-red-800 transition-colors">
                            <i class="fas fa-trash"></i>
                        </button>
                    </div>
                    
                    <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                        <div>
                            <label class="block text-sm font-medium text-gray-700 mb-2">Connector Type *</label>
                            <select name="Connectors[${connectorIndex}].Type" class="form-select" required>
                                <option value="">Select Type</option>
                                <option value="0">Type 1 (J1772)</option>
                                <option value="1">Type 2 (Mennekes)</option>
                                <option value="2">CHAdeMO</option>
                                <option value="3">CCS (Combined Charging System)</option>
                                <option value="4">Tesla Supercharger</option>
                            </select>
                        </div>
                        
                        <div>
                            <label class="block text-sm font-medium text-gray-700 mb-2">Power (kW) *</label>
                            <input name="Connectors[${connectorIndex}].Power" type="number" 
                                   class="form-input" min="1" max="350" step="0.1" 
                                   placeholder="e.g., 22.0" required>
                        </div>
                        
                        <div>
                            <label class="block text-sm font-medium text-gray-700 mb-2">Status</label>
                            <select name="Connectors[${connectorIndex}].Status" class="form-select">
                                <option value="0">Available</option>
                                <option value="1">Occupied</option>
                                <option value="2">Reserved</option>
                                <option value="3">Out of Order</option>
                                <option value="4">Maintenance</option>
                            </select>
                        </div>
                    </div>
                    
                    <div class="mt-4 flex items-center">
                        <input name="Connectors[${connectorIndex}].IsAvailable" type="checkbox" 
                               class="h-4 w-4 text-primary-600 focus:ring-primary-500 border-gray-300 rounded" checked>
                        <label class="ml-2 block text-sm text-gray-900">
                            Connector is available for booking
                        </label>
                    </div>
                </div>
            `;
            
            container.insertAdjacentHTML('beforeend', connectorHtml);
            connectorIndex++;
        }

        function removeConnector(index) {
            const connector = document.querySelector(`[data-index="${index}"]`);
            if (connector) {
                connector.remove();
            }
            
            // Renumber remaining connectors
            const connectors = document.querySelectorAll('.connector-item');
            connectors.forEach((connector, idx) => {
                const header = connector.querySelector('h4');
                header.innerHTML = `<i class="fas fa-bolt mr-2 text-yellow-500"></i>Connector ${idx + 1}`;
            });
        }

        // Form validation
        document.querySelector('form').addEventListener('submit', function(e) {
            const connectors = document.querySelectorAll('.connector-item');
            if (connectors.length === 0) {
                e.preventDefault();
                alert('Please add at least one connector to the charging station.');
                return;
            }

            // Validate that all connectors have required fields
            let valid = true;
            connectors.forEach(connector => {
                const type = connector.querySelector('select[name*="Type"]').value;
                const power = connector.querySelector('input[name*="Power"]').value;
                
                if (!type || !power) {
                    valid = false;
                }
            });

            if (!valid) {
                e.preventDefault();
                alert('Please fill in all connector details.');
            }
        });
    </script>
}