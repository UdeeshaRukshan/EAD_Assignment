<!DOCTYPE html>
<html lang="en" class="h-full bg-gray-50">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - EV Charging Station Management</title>
    <link rel="stylesheet" href="~/css/tailwind.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/EVChargingStation.Web.styles.css" asp-append-version="true" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet" />
</head>
<body class="h-full">
    <div class="min-h-full">
        <!-- Navigation -->
        <nav class="bg-white shadow-sm border-b border-gray-200">
            <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
                <div class="flex justify-between h-16">
                    <div class="flex items-center">
                        <div class="flex-shrink-0 flex items-center">
                            <i class="fas fa-charging-station text-primary-600 text-2xl mr-2"></i>
                            <a asp-controller="Dashboard" asp-action="Index" class="text-xl font-bold text-gray-900">
                                EV Station Manager
                            </a>
                        </div>
                        <div class="hidden md:ml-6 md:flex md:space-x-8">
                            <a asp-controller="Dashboard" asp-action="Index" 
                               class="border-transparent text-gray-500 hover:border-gray-300 hover:text-gray-700 inline-flex items-center px-1 pt-1 border-b-2 text-sm font-medium transition-colors">
                                <i class="fas fa-home mr-2"></i>Dashboard
                            </a>
                            <a asp-controller="Stations" asp-action="Index" 
                               class="border-transparent text-gray-500 hover:border-gray-300 hover:text-gray-700 inline-flex items-center px-1 pt-1 border-b-2 text-sm font-medium transition-colors">
                                <i class="fas fa-charging-station mr-2"></i>Charging Stations
                            </a>
                            <a asp-controller="Stations" asp-action="Create" 
                               class="border-transparent text-gray-500 hover:border-gray-300 hover:text-gray-700 inline-flex items-center px-1 pt-1 border-b-2 text-sm font-medium transition-colors">
                                <i class="fas fa-plus mr-2"></i>Add Station
                            </a>
                        </div>
                    </div>
                    
                    <div class="hidden md:flex md:items-center md:space-x-4">
                        <button class="bg-white p-1 rounded-full text-gray-400 hover:text-gray-500 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-primary-500">
                            <i class="fas fa-bell h-6 w-6"></i>
                        </button>
                        <div class="relative ml-3">
                            <button class="bg-white rounded-full flex text-sm focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-primary-500" id="user-menu-button">
                                <span class="sr-only">Open user menu</span>
                                <div class="h-8 w-8 rounded-full bg-primary-600 flex items-center justify-center">
                                    <i class="fas fa-user text-white text-sm"></i>
                                </div>
                            </button>
                        </div>
                    </div>
                    
                    <!-- Mobile menu button -->
                    <div class="md:hidden flex items-center">
                        <button type="button" class="bg-white inline-flex items-center justify-center p-2 rounded-md text-gray-400 hover:text-gray-500 hover:bg-gray-100 focus:outline-none focus:ring-2 focus:ring-inset focus:ring-primary-500" id="mobile-menu-button">
                            <span class="sr-only">Open main menu</span>
                            <i class="fas fa-bars h-6 w-6"></i>
                        </button>
                    </div>
                </div>
            </div>

            <!-- Mobile menu -->
            <div class="md:hidden hidden" id="mobile-menu">
                <div class="px-2 pt-2 pb-3 space-y-1 sm:px-3">
                    <a asp-controller="Home" asp-action="Index" class="text-gray-700 hover:bg-gray-50 block px-3 py-2 rounded-md text-base font-medium">
                        <i class="fas fa-home mr-2"></i>Dashboard
                    </a>
                    <a asp-controller="Stations" asp-action="Index" class="text-gray-700 hover:bg-gray-50 block px-3 py-2 rounded-md text-base font-medium">
                        <i class="fas fa-charging-station mr-2"></i>Charging Stations
                    </a>
                    <a asp-controller="Stations" asp-action="Create" class="text-gray-700 hover:bg-gray-50 block px-3 py-2 rounded-md text-base font-medium">
                        <i class="fas fa-plus mr-2"></i>Add Station
                    </a>
                </div>
            </div>
        </nav>

        <!-- Main content -->
        <main class="flex-1">
            @RenderBody()
        </main>

        <!-- Footer -->
        <footer class="bg-white border-t border-gray-200">
            <div class="max-w-7xl mx-auto py-6 px-4 sm:px-6 lg:px-8">
                <div class="flex justify-between items-center">
                    <p class="text-sm text-gray-500">
                        &copy; 2025 EV Charging Station Management. All rights reserved.
                    </p>
                    <div class="flex space-x-6">
                        <a asp-controller="Home" asp-action="Privacy" class="text-sm text-gray-500 hover:text-gray-900">Privacy Policy</a>
                        <a href="#" class="text-sm text-gray-500 hover:text-gray-900">Terms of Service</a>
                    </div>
                </div>
            </div>
        </footer>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script>
        // Mobile menu toggle
        document.getElementById('mobile-menu-button').addEventListener('click', function() {
            const menu = document.getElementById('mobile-menu');
            menu.classList.toggle('hidden');
        });
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
