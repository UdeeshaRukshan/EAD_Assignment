@model LoginViewModel
@{
    ViewData["Title"] = "Login";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en" class="h-full bg-gray-50">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Login - EV Charging Station Management</title>
    <link rel="stylesheet" href="~/css/tailwind.css" asp-append-version="true" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet" />
</head>
<body class="h-full">
    <div class="min-h-full flex items-center justify-center py-12 px-4 sm:px-6 lg:px-8">
        <div class="max-w-md w-full space-y-8">
            <div>
                <div class="mx-auto h-16 w-16 flex items-center justify-center rounded-full bg-primary-100">
                    <i class="fas fa-charging-station text-primary-600 text-3xl"></i>
                </div>
                <h2 class="mt-6 text-center text-3xl font-extrabold text-gray-900">
                    Sign in to your account
                </h2>
                <p class="mt-2 text-center text-sm text-gray-600">
                    EV Charging Station Management System
                </p>
            </div>

            <div class="bg-white py-8 px-4 shadow-lg rounded-lg sm:px-10">
                <form asp-action="Login" method="post" class="space-y-6">
                    @if (!string.IsNullOrEmpty(ViewBag.ErrorMessage?.ToString()))
                    {
                        <div class="bg-danger-50 border border-danger-200 text-danger-700 px-4 py-3 rounded-lg">
                            <div class="flex items-center">
                                <i class="fas fa-exclamation-circle mr-2"></i>
                                @ViewBag.ErrorMessage
                            </div>
                        </div>
                    }

                    <div>
                        <label asp-for="Email" class="block text-sm font-medium text-gray-700">
                            Email address
                        </label>
                        <div class="mt-1 relative">
                            <input asp-for="Email" type="email" autocomplete="email" required
                                   class="form-input @(ViewData.ModelState["Email"]?.Errors.Count > 0 ? "border-red-500" : "")"
                                   placeholder="Enter your email">
                            <div class="absolute inset-y-0 right-0 pr-3 flex items-center pointer-events-none">
                                <i class="fas fa-envelope text-gray-400"></i>
                            </div>
                        </div>
                        <span asp-validation-for="Email" class="text-red-500 text-sm"></span>
                    </div>

                    <div>
                        <label asp-for="Password" class="block text-sm font-medium text-gray-700">
                            Password
                        </label>
                        <div class="mt-1 relative">
                            <input asp-for="Password" type="password" autocomplete="current-password" required
                                   class="form-input @(ViewData.ModelState["Password"]?.Errors.Count > 0 ? "border-red-500" : "")"
                                   placeholder="Enter your password">
                            <div class="absolute inset-y-0 right-0 pr-3 flex items-center pointer-events-none">
                                <i class="fas fa-lock text-gray-400"></i>
                            </div>
                        </div>
                        <span asp-validation-for="Password" class="text-red-500 text-sm"></span>
                    </div>

                    <div class="flex items-center justify-end">
                        <div class="text-sm">
                            <a href="#" class="font-medium text-primary-600 hover:text-primary-500">
                                Forgot your password?
                            </a>
                        </div>
                    </div>

                    <div>
                        <button type="submit"
                                class="group relative w-full flex justify-center py-3 px-4 border border-transparent text-sm font-medium rounded-md text-white bg-primary-600 hover:bg-primary-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-primary-500 transition-colors duration-200">
                            <span class="absolute left-0 inset-y-0 flex items-center pl-3">
                                <i class="fas fa-sign-in-alt text-primary-500 group-hover:text-primary-400"></i>
                            </span>
                            Sign in
                        </button>
                    </div>

                    <div class="text-center">
                        <span class="text-sm text-gray-600">Don't have an account?</span>
                        <a asp-action="Register" class="font-medium text-primary-600 hover:text-primary-500 ml-1">
                            Sign up
                        </a>
                    </div>
                </form>
            </div>

            <!-- Demo Credentials -->
                    @{
    ViewData["Title"] = "Login";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="min-h-screen flex items-center justify-center bg-gradient-to-br from-blue-50 via-white to-green-50">
    <div class="max-w-md w-full space-y-8 p-8 bg-white rounded-xl shadow-lg">
        <div class="text-center">
            <h1 class="text-3xl font-bold text-gray-900">Welcome Back</h1>
            <p class="mt-2 text-gray-600">Sign in to EV Charging Station System</p>
        </div>

        <div class="bg-blue-50 p-4 rounded-md mb-4">
            <h3 class="text-sm font-semibold text-blue-900 mb-2">Demo Accounts</h3>
            <div class="space-y-1 text-sm">
                <p class="text-blue-800">
                    <span class="font-medium">Admin:</span> admin@evstation.com / Admin123!
                </p>
                <p class="text-blue-800">
                    <span class="font-medium">Operator:</span> operator@evstation.com / Operator123!
                </p>
                <p class="text-blue-800">
                    <span class="font-medium">User:</span> user@evstation.com / User123!
                </p>
            </div>
        </div>

        <form class="space-y-6" action="/Auth/Login" method="post">
            @Html.AntiForgeryToken()
            
            <div>
                <label for="Email" class="block text-sm font-medium text-gray-700 mb-2">
                    Email Address
                </label>
                <input 
                    id="Email" 
                    name="Email" 
                    type="email" 
                    required 
                    class="w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition-colors duration-200"
                    placeholder="Enter your email"
                />
            </div>

            <div>
                <label for="Password" class="block text-sm font-medium text-gray-700 mb-2">
                    Password
                </label>
                <input 
                    id="Password" 
                    name="Password" 
                    type="password" 
                    required 
                    class="w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition-colors duration-200"
                    placeholder="Enter your password"
                />
            </div>

            <div class="flex items-center justify-between">
                <div class="flex items-center">
                    <input 
                        id="RememberMe" 
                        name="RememberMe" 
                        type="checkbox" 
                        value="true"
                        class="h-4 w-4 text-blue-600 focus:ring-blue-500 border-gray-300 rounded"
                    />
                    <input name="RememberMe" type="hidden" value="false" />
                    <label for="RememberMe" class="ml-2 block text-sm text-gray-700">
                        Remember me
                    </label>
                </div>

                <div class="text-sm">
                    <a href="#" class="font-medium text-blue-600 hover:text-blue-500">
                        Forgot your password?
                    </a>
                </div>
            </div>

            <div>
                <button 
                    type="submit" 
                    class="group relative w-full flex justify-center py-3 px-4 border border-transparent text-sm font-medium rounded-md text-white bg-gradient-to-r from-blue-600 to-blue-700 hover:from-blue-700 hover:to-blue-800 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500 transition-all duration-200 transform hover:scale-105"
                >
                    <span class="absolute left-0 inset-y-0 flex items-center pl-3">
                        <svg class="h-5 w-5 text-blue-300 group-hover:text-blue-400" fill="currentColor" viewBox="0 0 20 20">
                            <path fill-rule="evenodd" d="M5 9V7a5 5 0 0110 0v2a2 2 0 012 2v5a2 2 0 01-2 2H5a2 2 0 01-2-2v-5a2 2 0 012-2zm8-2v2H7V7a3 3 0 016 0z" clip-rule="evenodd" />
                        </svg>
                    </span>
                    Sign in
                </button>
            </div>

            <div class="text-center">
                <p class="text-sm text-gray-600">
                    Don't have an account? 
                    <a href="/Auth/Register" class="font-medium text-blue-600 hover:text-blue-500">
                        Sign up here
                    </a>
                </p>
            </div>
        </form>
    </div>
</div>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script>
        // Auto-fill demo credentials
        document.addEventListener('DOMContentLoaded', function() {
            const urlParams = new URLSearchParams(window.location.search);
            const role = urlParams.get('role');
            
            if (role === 'admin') {
                document.getElementById('Email').value = 'admin@evstation.com';
                document.getElementById('Password').value = 'Admin123!';
            } else if (role === 'operator') {
                document.getElementById('Email').value = 'operator@evstation.com';
                document.getElementById('Password').value = 'Operator123!';
            } else if (role === 'user') {
                document.getElementById('Email').value = 'user@evstation.com';
                document.getElementById('Password').value = 'User123!';
            }
        });

        // Add click handlers for demo credentials
        document.querySelector('.bg-blue-50').addEventListener('click', function(e) {
            if (e.target.tagName === 'P') {
                const text = e.target.textContent;
                if (text.includes('admin@@')) {
                    document.getElementById('Email').value = 'admin@@evstation.com';
                    document.getElementById('Password').value = 'Admin123!';
                } else if (text.includes('operator@@')) {
                    document.getElementById('Email').value = 'operator@@evstation.com';
                    document.getElementById('Password').value = 'Operator123!';
                } else if (text.includes('user@@')) {
                    document.getElementById('Email').value = 'user@@evstation.com';
                    document.getElementById('Password').value = 'User123!';
                }
            }
        });
    </script>
</body>
</html>