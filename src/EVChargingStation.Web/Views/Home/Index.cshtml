@{
    ViewData["Title"] = "Dashboard";
}

<div class="max-w-7xl mx-auto py-6 sm:px-6 lg:px-8">
    <!-- Hero Section -->
    <div class="px-4 py-6 sm:px-0">
        <div class="text-center mb-12">
            <div class="mx-auto h-24 w-24 mb-6">
                <i class="fas fa-charging-station text-6xl text-primary-600"></i>
            </div>
            <h1 class="text-4xl font-bold text-gray-900 mb-4">
                EV Charging Station Management
            </h1>
            <p class="text-xl text-gray-600 max-w-2xl mx-auto">
                Manage and monitor your electric vehicle charging stations with our comprehensive platform
            </p>
        </div>

        <!-- Quick Actions -->
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-12">
            <a asp-controller="Stations" asp-action="Index" 
               class="group block p-8 bg-white rounded-xl shadow-md border border-gray-200 hover:shadow-lg transition-all duration-200 hover:-translate-y-1">
                <div class="flex items-center justify-center h-16 w-16 mx-auto mb-4 rounded-full bg-primary-100 group-hover:bg-primary-200 transition-colors">
                    <i class="fas fa-list text-primary-600 text-2xl"></i>
                </div>
                <h3 class="text-xl font-semibold text-gray-900 mb-2 text-center">View Stations</h3>
                <p class="text-gray-600 text-center">Browse and manage all charging stations</p>
            </a>

            <a asp-controller="Stations" asp-action="Create" 
               class="group block p-8 bg-white rounded-xl shadow-md border border-gray-200 hover:shadow-lg transition-all duration-200 hover:-translate-y-1">
                <div class="flex items-center justify-center h-16 w-16 mx-auto mb-4 rounded-full bg-success-100 group-hover:bg-success-200 transition-colors">
                    <i class="fas fa-plus text-success-600 text-2xl"></i>
                </div>
                <h3 class="text-xl font-semibold text-gray-900 mb-2 text-center">Add Station</h3>
                <p class="text-gray-600 text-center">Create a new charging station</p>
            </a>

            <a href="#" class="group block p-8 bg-white rounded-xl shadow-md border border-gray-200 hover:shadow-lg transition-all duration-200 hover:-translate-y-1">
                <div class="flex items-center justify-center h-16 w-16 mx-auto mb-4 rounded-full bg-warning-100 group-hover:bg-warning-200 transition-colors">
                    <i class="fas fa-chart-bar text-warning-600 text-2xl"></i>
                </div>
                <h3 class="text-xl font-semibold text-gray-900 mb-2 text-center">Analytics</h3>
                <p class="text-gray-600 text-center">View usage statistics and reports</p>
            </a>
        </div>

        <!-- Features Section -->
        <div class="bg-white rounded-xl shadow-md border border-gray-200 p-8">
            <h2 class="text-2xl font-bold text-gray-900 mb-8 text-center">
                <i class="fas fa-star mr-3 text-primary-600"></i>
                Platform Features
            </h2>
            
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
                <div class="flex items-start">
                    <div class="flex-shrink-0">
                        <div class="flex items-center justify-center h-12 w-12 rounded-md bg-primary-500 text-white">
                            <i class="fas fa-charging-station text-xl"></i>
                        </div>
                    </div>
                    <div class="ml-4">
                        <h3 class="text-lg font-medium text-gray-900">Station Management</h3>
                        <p class="mt-2 text-base text-gray-500">
                            Create, update, and manage charging stations with location, type (AC/DC), and available slots.
                        </p>
                    </div>
                </div>

                <div class="flex items-start">
                    <div class="flex-shrink-0">
                        <div class="flex items-center justify-center h-12 w-12 rounded-md bg-success-500 text-white">
                            <i class="fas fa-calendar-alt text-xl"></i>
                        </div>
                    </div>
                    <div class="ml-4">
                        <h3 class="text-lg font-medium text-gray-900">Schedule Updates</h3>
                        <p class="mt-2 text-base text-gray-500">
                            Update station details and schedules including availability of slots in real-time.
                        </p>
                    </div>
                </div>

                <div class="flex items-start">
                    <div class="flex-shrink-0">
                        <div class="flex items-center justify-center h-12 w-12 rounded-md bg-warning-500 text-white">
                            <i class="fas fa-shield-alt text-xl"></i>
                        </div>
                    </div>
                    <div class="ml-4">
                        <h3 class="text-lg font-medium text-gray-900">Safe Deactivation</h3>
                        <p class="mt-2 text-base text-gray-500">
                            Deactivate stations safely with automatic validation to prevent issues with active bookings.
                        </p>
                    </div>
                </div>

                <div class="flex items-start">
                    <div class="flex-shrink-0">
                        <div class="flex items-center justify-center h-12 w-12 rounded-md bg-indigo-500 text-white">
                            <i class="fas fa-mobile-alt text-xl"></i>
                        </div>
                    </div>
                    <div class="ml-4">
                        <h3 class="text-lg font-medium text-gray-900">Mobile App</h3>
                        <p class="mt-2 text-base text-gray-500">
                            Complete Android mobile application for users to find and book charging stations.
                        </p>
                    </div>
                </div>

                <div class="flex items-start">
                    <div class="flex-shrink-0">
                        <div class="flex items-center justify-center h-12 w-12 rounded-md bg-purple-500 text-white">
                            <i class="fas fa-cog text-xl"></i>
                        </div>
                    </div>
                    <div class="ml-4">
                        <h3 class="text-lg font-medium text-gray-900">API Integration</h3>
                        <p class="mt-2 text-base text-gray-500">
                            RESTful API with JWT authentication for secure integration with mobile and web applications.
                        </p>
                    </div>
                </div>

                <div class="flex items-start">
                    <div class="flex-shrink-0">
                        <div class="flex items-center justify-center h-12 w-12 rounded-md bg-pink-500 text-white">
                            <i class="fas fa-users text-xl"></i>
                        </div>
                    </div>
                    <div class="ml-4">
                        <h3 class="text-lg font-medium text-gray-900">Multi-User Support</h3>
                        <p class="mt-2 text-base text-gray-500">
                            Role-based access control for admins, operators, and EV owners with different permissions.
                        </p>
                    </div>
                </div>
            </div>
        </div>

        <!-- Call to Action -->
        <div class="mt-12 text-center">
            <div class="bg-primary-50 rounded-xl p-8 border border-primary-200">
                <h2 class="text-2xl font-bold text-primary-900 mb-4">Ready to get started?</h2>
                <p class="text-primary-700 mb-6">Begin managing your EV charging stations today.</p>
                <div class="space-x-4">
                    <a asp-controller="Stations" asp-action="Index" class="btn-primary">
                        <i class="fas fa-arrow-right mr-2"></i>
                        View Stations
                    </a>
                    <a asp-controller="Stations" asp-action="Create" class="btn-secondary">
                        <i class="fas fa-plus mr-2"></i>
                        Add First Station
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
